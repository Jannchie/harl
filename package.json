{
  "name": "harl-monorepo",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "cargo run -p harl -- serve",
    "capture": "cargo run -p harl -- capture",
    "dev:web": "pnpm --filter harl-web dev",
    "build": "pnpm --filter harl-web build",
    "build:all": "pnpm build && cargo build --release"
  }
}
